---
title: "Prompt Library"
description: "A searchable library of prompts, rules, agents, skills, and resources for practical AI workflows across project teams."
layout: "base.njk"
eyebrow: "AI workflows, ready to reuse"
heading: "Find the right prompt before the work starts."
hideHeaderSearch: true
needsSwiper: true
---
{% from "_lib-button.njk" import libButton %}
{% from "_type-card.njk" import typeCard %}
{% from "_icons.njk" import chevron %}

{% set displayTypes = ['prompts', 'rules', 'agents', 'skills', 'resources'] %}
{% set allDisciplines = ['development', 'project-management', 'sales-marketing', 'content-strategy', 'design', 'quality-assurance', 'admin'] %}
{% set matrixDisciplines = [
  { slug: 'project-management', label: 'Project Management' },
  { slug: 'development', label: 'Development' },
  { slug: 'content-strategy', label: 'Content Strategy' },
  { slug: 'design', label: 'Design' },
  { slug: 'quality-assurance', label: 'Quality Assurance' },
  { slug: 'sales-marketing', label: 'Sales & Marketing' },
  { slug: 'admin', label: 'Admin' }
] %}
{% set typeDescriptions = {
  prompts: 'Reusable starting points for repeatable AI tasks.',
  rules: 'Reusable standards for writing, code quality, and team conventions.',
  agents: 'Role-based assistants for structured project workflows.',
  skills: 'Installable workflows for Claude Code and project-specific tasks.',
  resources: 'Reference links, documentation, and learning material.'
} %}
{% set totalResources = displayTypes | sumTypeCounts %}
{% set disciplineCount = allDisciplines | activeDisciplineCount(displayTypes) %}
{# The carousel shows the newest items; the listing pages hold the rest. #}
{% set recentLimit = 12 %}

<div class="pl-container pl-main pl-stack">

  {# Search: counts, then the filter band #}
  <section class="pl-stack-sm" aria-label="Search the library">
    <div class="pl-row">
      <span class="ds-count">{{ totalResources }} resources</span>
      <span class="ds-count">{{ displayTypes | length }} content types</span>
      <span class="ds-count">{{ disciplineCount }} disciplines</span>
    </div>

    <div class="ds-band">
      <form class="search-form pl-search__form" role="search">
        <div class="pl-search__field">
          <label class="ds-label" for="search-input">Search prompts, rules, agents, and skills</label>
          <input type="search" id="search-input" class="ds-input search-input" autocomplete="off">
          <div id="search-results" class="search-results" hidden></div>
        </div>
        <button type="submit" class="ds-btn ds-btn-primary">Search</button>
      </form>
      <div class="pl-chips" role="group" aria-label="Quick searches">
        <button type="button" class="ds-btn ds-btn-tertiary pl-chip" data-query="prompt" aria-pressed="false">Prompts</button>
        <button type="button" class="ds-btn ds-btn-tertiary pl-chip" data-query="skill" aria-pressed="false">Skills</button>
        <button type="button" class="ds-btn ds-btn-tertiary pl-chip" data-query="agent" aria-pressed="false">Agents</button>
        <button type="button" class="ds-btn ds-btn-tertiary pl-chip" data-query="development" aria-pressed="false">Development</button>
        <button type="button" class="ds-btn ds-btn-tertiary pl-chip" data-query="content strategy" aria-pressed="false">Content Strategy</button>
      </div>
    </div>
  </section>

  {# Install callout #}
  {% include "skills-bundle-banner.njk" %}

  {# Recently Added (carousel) #}
  <section>
    <div class="pl-section-head pl-mb-24">
      <div>
        <p class="ds-eyebrow">Recently Added</p>
        <h2 class="ds-section-title">New and updated workflows</h2>
        <p class="ds-section-note">The latest prompts, rules, agents, and skills added to the library.</p>
      </div>
      <div class="pl-row">
        {{ libButton("View all", baseUrl + "/skills/", "text") }}
        <div class="pl-row pl-row-tight">
          <button type="button" class="ds-btn ds-btn-secondary pl-carousel-prev" aria-label="Previous items">{{ chevron("prev") }}</button>
          <button type="button" class="ds-btn ds-btn-secondary pl-carousel-next" aria-label="Next items">{{ chevron("next") }}</button>
        </div>
      </div>
    </div>
    <div class="swiper pl-carousel recently-added-swiper">
      <div class="swiper-wrapper">
        {% for item in collections.recentlyAdded %}
        {% if loop.index <= recentLimit %}
          <div class="swiper-slide">
            <article class="ds-panel pl-recent">
              <h3 class="ds-heading-md"><a class="ds-link" href="{{ item.url | fullUrl }}">{{ item.data.title }}</a></h3>
              <div class="pl-row pl-row-tight">
                {% if item.data.contentType %}<span class="ds-tag">{{ item.data.contentType | replace('-', ' ') | title }}</span>{% endif %}
                {% if item.data.discipline %}<span class="ds-tag">{{ item.data.discipline | replace('-', ' ') | title }}</span>{% endif %}
                {% if item.data.version %}<span class="ds-tag">v{{ item.data.version }}</span>{% endif %}
                {% if item | isRecentlyUpdated %}<span class="ds-tag">Updated</span>{% endif %}
              </div>
              <p class="ds-body-sm">{{ item.data.description }}</p>
            </article>
          </div>
        {% endif %}
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </section>

  {# Browse by Type #}
  <section>
    <div class="pl-section-head pl-mb-24">
      <div>
        <p class="ds-eyebrow">Browse by Type</p>
        <h2 class="ds-section-title">Choose the shape of help you need</h2>
        <p class="ds-section-note">Each content type has a different job: starting points, standards, installable workflows, role-based assistants, and reference material.</p>
      </div>
    </div>
    <div class="pl-grid pl-grid--types">
      {% for t in displayTypes %}
        {{ typeCard(t | replace('-', ' ') | title, t | typeCount, typeDescriptions[t], baseUrl + "/" + t + "/") }}
      {% endfor %}
    </div>
  </section>

  {# Browse by Discipline (matrix) #}
  <section>
    <div class="pl-section-head pl-mb-24">
      <div>
        <p class="ds-eyebrow">Browse by Discipline</p>
        <h2 class="ds-section-title">A library map for every team</h2>
        <p class="ds-section-note">A compact matrix so people can scan across teams and resource types quickly.</p>
      </div>
    </div>
    <div class="pl-scroll-x">
      <table class="pl-matrix" aria-label="Resources by discipline and type">
        <thead>
          <tr>
            <th scope="col">Discipline</th>
            {% for t in displayTypes %}
            <th scope="col">{{ t | replace('-', ' ') | title }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for d in matrixDisciplines %}
          <tr>
            <th scope="row"><a href="{{ baseUrl }}/{{ d.slug }}/">{{ d.label }}</a></th>
            {% for t in displayTypes %}
            {% set n = d.slug | disciplineTypeCount(t) %}
            <td>
              {% if n > 0 %}<a href="{{ baseUrl }}/{{ d.slug }}/{{ t }}/" aria-label="{{ n }} {{ t | replace('-', ' ') }} in {{ d.label }}">{{ n }}</a>{% else %}<span class="ds-muted" aria-label="None">&ndash;</span>{% endif %}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  {# Share your knowledge #}
  <section class="ds-panel pl-cta">
    <div>
      <h2 class="ds-section-title">Share your best workflow</h2>
      <p class="ds-section-note">Submit a prompt, rule, agent, or skill and help the library become more useful for everyone.</p>
    </div>
    <div class="pl-row">
      {{ libButton("Submit a prompt", "https://github.com/Lullabot/prompt_library/issues/new?template=prompt-submission.yml", "primary", true) }}
      {{ libButton("Contribution guide", baseUrl + "/contributing", "text") }}
    </div>
  </section>

</div>

<script>
  // Recently Added carousel (Swiper). Waits until the Swiper lib has loaded.
  (function () {
    var IDLE_MS = 30000; // resume autoplay after this long without interaction
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function initRecentlyAddedSwiper() {
      var idleTimer = null;
      var swiper = new Swiper('.recently-added-swiper', {
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        watchSlidesProgress: true,
        // No automatic movement for people who asked for reduced motion.
        autoplay: reduceMotion ? false : { delay: 5000, disableOnInteraction: false },
        pagination: { el: '.swiper-pagination', clickable: true, dynamicBullets: true },
        navigation: { nextEl: '.pl-carousel-next', prevEl: '.pl-carousel-prev' },
        breakpoints: {
          768: { slidesPerView: 2 },
          960: { slidesPerView: 3 }
        }
      });
      if (reduceMotion) { return; }

      // Pause autoplay on any interaction; resume after 30s of inactivity.
      function onInteract() {
        if (swiper.autoplay) { swiper.autoplay.stop(); }
        if (idleTimer) { clearTimeout(idleTimer); }
        idleTimer = setTimeout(function () {
          if (swiper.autoplay) { swiper.autoplay.start(); }
        }, IDLE_MS);
      }
      swiper.el.addEventListener('pointerdown', onInteract, { passive: true });
      swiper.el.addEventListener('keydown', onInteract);
      document.querySelectorAll('.pl-carousel-prev, .pl-carousel-next').forEach(function (button) {
        button.addEventListener('click', onInteract);
      });
    }
    function checkSwiperAndInit() {
      if (typeof Swiper !== 'undefined') { initRecentlyAddedSwiper(); }
      else { requestAnimationFrame(checkSwiperAndInit); }
    }
    requestAnimationFrame(checkSwiperAndInit);
  })();
</script>
