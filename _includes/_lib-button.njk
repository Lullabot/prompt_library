{#
  Library button: a link styled with the Lullabot App Design System.
  variant: "primary"   .ds-btn-primary, the call to action (56px, red outline)
           "secondary" .ds-btn-secondary, a compact action (40px)
           "text"      .ds-btn-text, a minor or navigational action
  Primary and text variants end in the system's arrow.
  Usage: {% from "_lib-button.njk" import libButton %}
         {{ libButton("Contribution guide", baseUrl + "/contributing", "text") }}
#}
{% from "_icons.njk" import arrow %}
{% macro libButton(label, href, variant="primary", newTab=false) %}
<a class="{% if variant == 'text' %}ds-btn-text{% else %}ds-btn ds-btn-{{ variant }}{% endif %}" href="{{ href }}"{% if newTab %} target="_blank" rel="noopener noreferrer"{% endif %}>
  {{ label }}
  {% if variant != 'secondary' %}{{ arrow() }}{% endif %}
</a>
{% endmacro %}
