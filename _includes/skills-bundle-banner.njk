{# Promotes the lullabot-skills Claude Code bundle install command.
   Used on the home page and on /skills/. The copy button is wired by
   assets/js/main.js through its data-copy attribute. #}
{% set skillsBundleCmd = "git clone https://github.com/Lullabot/lullabot-skills.git .claude/skills" %}
<section class="ds-panel pl-install" aria-labelledby="skills-bundle-title">
  <div>
    <p class="ds-eyebrow pl-mb-16">Claude Code skills bundle</p>
    <h2 id="skills-bundle-title" class="ds-section-title">Install all skills at once</h2>
    <p class="ds-section-note">
      Every skill is bundled in <a class="ds-link" href="https://github.com/Lullabot/lullabot-skills" target="_blank" rel="noopener">Lullabot/lullabot-skills</a>. Clone it into <code>.claude/skills/</code> and Claude Code picks them all up automatically.
    </p>
  </div>
  <div class="pl-command">
    <pre><code>{{ skillsBundleCmd }}</code></pre>
    <button type="button" class="ds-btn ds-btn-secondary" data-copy="{{ skillsBundleCmd }}">
      <span data-copy-label>Copy command</span>
    </button>
  </div>
</section>
