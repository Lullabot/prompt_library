---
layout: discipline.njk
pageKind: listing
---
{% from "_content-table.njk" import contentTable, countLabel %}
{% from "_icons.njk" import arrow %}

{% set items = collections[contentType] | filterByDiscipline(discipline) %}
{% set typeLabel = contentType | replace("-", " ") | title %}
<section class="pl-stack-sm">
    {% if items | length %}
    <div class="pl-row">
        <span class="ds-count">{{ countLabel(items | length, contentType) }}</span>
    </div>
    {{ contentTable(items, title) }}
    {% else %}
    <div class="ds-empty">
        <p class="ds-empty-title">No {{ typeLabel | lower }} yet</p>
        <p class="ds-empty-text">Nothing has been added to this section. Submissions appear here once they are merged.</p>
        <a class="ds-btn-text" href="{{ baseUrl }}/contributing">How to contribute {{ arrow() }}</a>
    </div>
    {% endif %}
</section>
