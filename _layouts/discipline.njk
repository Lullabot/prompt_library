---
layout: base.njk
pageKind: discipline
---
{% from "_content-table.njk" import contentTable, countLabel %}
{% from "_icons.njk" import arrow %}

{# Fall back to deriving the discipline from the URL so a page that forgets the
   `discipline` frontmatter doesn't produce broken `//<type>` nav links. #}
{% set disc = discipline or (page.url | disciplineFromUrl) %}
{% set discLabel = disc | replace("-", " ") | title %}
{% set typeTabs = ['prompts', 'rules', 'project-configs', 'agents', 'skills', 'resources'] %}

<div class="pl-container pl-main pl-stack">
    <nav class="pl-tabs" aria-label="{{ discLabel }} content types">
        <a class="ds-sort-tab{% if not contentType %} ds-sort-tab-active{% endif %}" href="{{ baseUrl }}/{{ disc }}/"{% if not contentType %} aria-current="page"{% endif %}>Overview</a>
        {% for type in typeTabs %}
        <a class="ds-sort-tab{% if contentType == type %} ds-sort-tab-active{% endif %}" href="{{ baseUrl }}/{{ disc }}/{{ type }}/"{% if contentType == type %} aria-current="page"{% endif %}>{{ type | replace("-", " ") | title }}</a>
        {% endfor %}
    </nav>

    {# Landing page (no contentType set): list ALL of the discipline's content,
       grouped by content type. Content-type pages set `contentType`, so this block
       is skipped there to avoid double-listing. #}
    {% if not contentType %}
    {% set typeOrder = ['prompts', 'rules', 'agents', 'skills', 'project-configs', 'resources', 'workflow-states'] %}
    {% for type in typeOrder %}
        {% set items = collections[type] | filterByDiscipline(disc) %}
        {% if items | length %}
        {% set typeLabel = type | replace("-", " ") | title %}
        <section>
            <div class="pl-section-head pl-mb-24">
                <h2 class="ds-section-title">{{ typeLabel }}</h2>
                <span class="ds-count">{{ countLabel(items | length, type) }}</span>
            </div>
            {{ contentTable(items, typeLabel + " in " + discLabel) }}
        </section>
        {% endif %}
    {% endfor %}
    {% if (disc | disciplineContentCount) == 0 %}
    <div class="ds-empty">
        <p class="ds-empty-title">Nothing here yet</p>
        <p class="ds-empty-text">No content has been added to {{ discLabel }}. Prompts, rules, agents and resources appear here once they are submitted.</p>
        <a class="ds-btn-text" href="{{ baseUrl }}/contributing">How to contribute {{ arrow() }}</a>
    </div>
    {% endif %}
    {% endif %}

    {{ content | safe }}
</div>
