---
title: "All Skills"
description: "Browse all skills across every discipline."
layout: "base.njk"
eyebrow: "Library"
---
{% from "_content-table.njk" import contentTable, countLabel %}
{% from "_icons.njk" import arrow %}

{% set items = collections.skills %}
<div class="pl-container pl-main pl-stack">
  {% include "skills-bundle-banner.njk" %}

  <section class="pl-stack-sm">
    {% if items | length %}
    <div class="pl-row">
      <span class="ds-count">{{ countLabel(items | length, "skills") }}</span>
    </div>
    {{ contentTable(items, title, true) }}
    {% else %}
    <div class="ds-empty">
      <p class="ds-empty-title">No skills yet</p>
      <p class="ds-empty-text">Nothing has been added here. Submissions appear once they are merged.</p>
      <a class="ds-btn-text" href="{{ baseUrl }}/contributing">How to contribute {{ arrow() }}</a>
    </div>
    {% endif %}
  </section>
</div>
